{
    "name": "@ostro/cache",
    "version": "2.0.0-alpha.7",
    "description": "Caching module for OstroJS",
    "main": "cacheManager.js",
    "types": ".types/cacheManager.d.ts",
    "exports": {
        ".": {
            "types": "./.types/cacheManager.d.ts",
            "default": "./cacheManager.js"
        },
        "./*": {
            "types": "./.types/*.d.ts",
            "default": "./*.js"
        }
    },
    "scripts": {
        "build": "npm run lint:check && rm -rf build && npx tsc -p tsconfig.build.json && mkdir -p build/console/stubs && cp src/console/stubs/* build/console/stubs/ && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit -p tsconfig.build.json"
    },
    "dependencies": {
        "@ostro/support": "^2.0.0-alpha.9",
        "bluebird": "^3.7.2",
        "fs-extra": "^11.4.1"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "cache"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/cache.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/cache/issues"
    },
    "homepage": "https://github.com/ostrojs/cache#readme",
    "devDependencies": {
        "@ostro/builder": "^2.0.0-alpha.6",
        "@ostro/console": "^2.0.0-alpha.9",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
